<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GodotMcp.Shim</RootNamespace>
    <AssemblyName>godot-mcp-shim</AssemblyName>
    <!-- 版本随插件产品线(plugin.cfg 1.0.0;迁移期纪律,随 18/19 收尾)。 -->
    <Version>1.0.0</Version>
    <!-- 发布形态为 NativeAOT(见 Properties/PublishProfiles/*.pubxml):常规构建也开 AOT/裁剪分析器,
         让反射序列化等不兼容 AOT 的写法在编码阶段就报警,而不是等到发布时才出现。 -->
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

</Project>
