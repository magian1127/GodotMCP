<?xml version="1.0" encoding="utf-8"?>
<!-- 发布:
     dotnet publish src/godot-mcp-shim -c Release -p:PublishProfile=osx-x64
     产物:server-dotnet/publish/osx-x64/godot-mcp-shim
     落点与 daemon 同一目录(见 win-x64.pubxml 说明)。
     形态:在 macOS 本机发布为 NativeAOT;在其他系统上交叉发布回退为自包含单文件(见 win-x64.pubxml 说明)。 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>osx-x64</RuntimeIdentifier>
    <PublishDir>..\..\publish\osx-x64\</PublishDir>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('OSX'))">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>
</Project>
