<?xml version="1.0" encoding="utf-8"?>
<!-- 发布:
     dotnet publish src/godot-mcp-shim -c Release -p:PublishProfile=win-x64
     产物:server-dotnet/publish/win-x64/godot-mcp-shim.exe
     落点与 daemon 同一目录:shim 缺省从自身同目录解析 godot-mcp-daemon(.exe),
     因此两个工程共用同一个 PublishDir(发布后由 csproj 的 AfterPublish
     步骤同步到 addons/godot_mcp_toolkit/bin/<rid>/)。

     形态:在目标系统本机发布时为 NativeAOT(约 4 MB;无 JIT,每会话私有内存约为自包含
     单文件的一半)。NativeAOT 不能跨系统编译,在其他系统上交叉发布时回退为自包含单文件
     (约 70 MB)。本机工具链要求见 server-dotnet/README.md 的"发布"一节;没有工具链时
     加 -p:PublishAot=false -p:SelfContained=true -p:PublishSingleFile=true 即回到自包含单文件。 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <!-- 原生 PDB 约 20 MB:只留在 bin/ 供调试,不进发布目录(也就不会被同步进 addon)。 -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>
</Project>
