<?xml version="1.0" encoding="utf-8"?>
<!-- self-contained 单文件发布(交叉构建):
     dotnet publish src/godot-mcp-shim -c Release -p:PublishProfile=linux-x64
     产物:server-dotnet/publish/linux-x64/godot-mcp-shim
     落点与 daemon 同一目录(见 win-x64.pubxml 说明)。 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishDir>..\..\publish\linux-x64\</PublishDir>
  </PropertyGroup>
</Project>
