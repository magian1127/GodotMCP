<?xml version="1.0" encoding="utf-8"?>
<!-- self-contained 单文件发布(spec US21 / issue 03 验收):
     dotnet publish src/godot-mcp-daemon -c Release -p:PublishProfile=osx-arm64
     产物:server-dotnet/publish/osx-arm64/godot-mcp-daemon -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishDir>..\..\publish\osx-arm64\</PublishDir>
  </PropertyGroup>
</Project>
