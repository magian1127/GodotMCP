{
  "name": "deepseek-harness-godot_unified",
  "version": "0.4.0",
  "type": "module",
  "description": "Godot MCP Unified for DSH：把 GodotMCP 桥接服务器接入 DSH 的 @deepseek-ai/dsh-mcp-client 行与 Godot 工作流提示词 section，附安装/卸载/体检 CLI。Godot MCP Unified bridge row + workflow prompt section for DSH, with an install/uninstall/status CLI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magian1127/deepseek-harness-godot_unified.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-godot": "bin/dsh-godot.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs",
    "src",
    "tsconfig.json",
    "tsconfig.cli.json",
    "tsconfig.tests.json",
    "tsdown.config.ts",
    "verify-build.mjs"
  ],
  "scripts": {
    "build:host": "tsc -p tsconfig.json",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:tests": "tsc -p tsconfig.tests.json",
    "build:client": "tsdown --config tsdown.config.ts",
    "build": "npm run build:host && npm run build:cli && npm run build:tests && npm run build:client",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.cli.json --noEmit",
    "test": "npm run build && node --test \".tsbuild/tests/*.test.mjs\"",
    "verify": "node verify-build.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "godot",
    "mcp",
    "gamedev",
    "gdscript"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.8.3"
  }
}
